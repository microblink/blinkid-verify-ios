        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එහි තාක්ෂණය ප්‍රශස්ත කිරීමේ අරමුණින් සැපයුම්කරු විසින් මගේ පුද්ගලික දත්ත භාවිත කිරීමට මම එකඟ වෙමි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súhlasím s používaním mojich osobných údajov poskytovateľom na účely optimalizácie jeho technológie."
          }
        },
        "sl": {
          "stringUnit": {
