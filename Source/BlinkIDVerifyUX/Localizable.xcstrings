          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইন্টারনেটে পুনরায় সংযোগের চেষ্টা করতে দুবার ট্যাপ করুন"
          }
        },
        "cs": {
          "stringUnit": {
