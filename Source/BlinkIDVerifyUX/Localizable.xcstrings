    "mb_connection_reconnect": {
      "comment": "connection.reconnect: Hint on the no-internet-connection screen telling the user how to trigger another connection attempt.",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Bɔ no mprenu na san sɔ Intanɛt nkitahodi no hwɛ"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከኢንተርኔት ጋር እንደገና ለመገናኘት ሁለት ጊዜ መታ ያድርጉ"
