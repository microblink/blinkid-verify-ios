            "value": "Udržujte fotografiu tváre úplne viditeľnú"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija obraza naj bo v celoti vidna"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neka fotografija lica bude potpuno vidljiva"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ansiktsfotot helt synligt"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakikisha picha ya uso inaonekana kikamilifu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เห็นรูปถ่ายใบหน้าทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz fotoğrafını tamamen görünür tutun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте фото обличчя повністю видимим"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چہرے کی تصویر کو مکمل طور پر دکھائی دینے دیں"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuz fotosurati to‘liq ko‘rinib turishini ta’minlang"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo ảnh khuôn mặt hiển thị đầy đủ"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Jẹ́ kí fọ́tò ojú náà hàn pátápátá"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保人像照片完全可见"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請讓人像照片完整可見"
          }
        }
      }
    },
    "mb_flashlight_warning_message": {
      "comment": "scan.error.flashlight: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Hwɛ sɛ wobehu flashlight hann bi a.\nNkakrankakra no fa wo ID no kyinkyin na antɔ so."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የባትሪ ብርሃን እንዳያበራ ይጠንቀቁ።\nይህንን ለማስወገድ መታወቂያዎን በቀስታ ያንቀሳቅሱት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احترس من وهج المصباح. \n حرك هويتك برفق لتتجنبه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্ল্যাশলাইটের ঝলকানি থেকে সতর্ক থাকুন।\nএটি এড়াতে আপনার আইডিটি আলতো করে ঘোরান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte pozor na odlesky způsobené bleskem.\nVyhnete se jim lehkým posunutím vašeho průkazu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold øje med lygtens genskin.\nFlyt dit ID forsigtigt rundt for at undgå det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achten Sie auf eine Blendung durch Blitzlicht.\n Bewegen Sie Ihren Ausweis vorsichtig umher, um dies zu vermeiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσέξτε την αντανάκλαση από τον φακό.\nΚουνήστε απαλά την ταυτότητά σας για να την αποφύγετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch out for flashlight glare.\nGently move your ID around to avoid it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch out for torch glare.\nGently move your ID around to avoid it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenga cuidado con el resplandor de la linterna.\nMueva suavemente su ID a su alrededor para evitarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención al reflejo de la linterna.\nMueve ligeramente tu identificación para evitarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Havasetan be tabesh-e nur-e flash bashad.\nMadrak-e hoviyati ra aheste jabeja konid ta tabesh az beyn beravad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varo salaman häikäisyä.\nSiirrä henkilötodistusta varovasti välttääksesi häikäisyn."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-ingat sa flashlight glare.\nDahan-dahang ilipat ang iyong ID sa paligid upang maiwasan ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention aux reflets de la lampe de poche.\nBougez doucement votre pièce d'identité pour les éviter."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites attention à l'éblouissement causé par le flash.\nVeuillez déplacer délicatement votre pièce d'identité pour l'éviter."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A duba idan akwai wurin da haske ya dusashe takardar.\nA motsa ID ɗin a hankali domin kauce wa hasken."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היזהרו מפני סנוור הפנס.\nהזיזו בעדינות את תעודת הזהות שלכם בכדי להימנע מהדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टॉर्च की चमक से सावधान रहें.\nइससे बचने के लिए अपनी आईडी को धीरे से इधर-उधर घुमाएं."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smanjite odsjaj bljeskalice laganim pomicanjem dokumenta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyeljen oda a vaku fényének visszaverődésére.\nFinoman mozgassa a személyi igazolványát, hogy elkerülje."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waspadai kilau blitz.\nPindahkan ID Anda dengan perlahan untuk menghindarinya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gætið að glampi frá vasaljósi.\nFærið skilríkin varlega til að forðast þau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione al riflesso della luce.\nMuovi lentamente il documento per evitarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フラッシュライトの反射にご注意ください。\n反射を避けるため,身分証明書をゆっくりと動かしてください。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "მოერიდეთ ბლიცის მკვეთრ ნათებას.\nოდნავ გაამოძრავეთ თქვენი პირადობის მოწმობა მის თავიდან ასაცილებლად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жарықтың шағылыспауына назар аударыңыз.\nМұндай шағылыс пайда болса, оны болдырмау үшін жеке куәлікті ақырын жылжытыңыз."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមប្រយ័ត្នចំពោះពន្លឺពិល។\nផ្លាស់ទីលេខសម្គាល់របស់អ្នកដោយថ្នមៗ ដើម្បីជៀសវាងវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손전등 반사광에 주의하세요.\n신분증을 조금씩 움직여 반사를 피해주세요."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzmanieties no zibspuldzes atspīduma.\nUzmanīgi kustiniet savu ID, lai no tā izvairītos."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhati-hati dengan silau lampu suluh.\nGerakkan ID anda dengan perlahan keliling untuk menjauhinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass deg for gjenskinn fra sterkt lys.\n Flytt ID-en din rundt for å unngå det."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्ल्यासलाइटबाट सावधान रहनुहोस्। त्यसलाई रोक्न आफ्नो परिचयपत्र बिस्तारै मिलाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas op voor schittering van de flitser.\nVerplaats uw ID voorzichtig om dit te voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwróć uwagę na odblaski od flesza.\nDelikatnie zmień pozycję dokumentu, aby ich uniknąć."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "د فلش لائټ ځلا ته پام وکړئ.\nخپل ID په نرمۍ سره حرکت ورکړئ ترڅو له دې څخه مخنیوی وشي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha cuidado com o clarão da lanterna. \n Mova de forma ligeira a sua identificação para o evitar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuidado com o brilho da lanterna. \nMova seu documento de identidade com cuidado para evitá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiți atent la strălucirea cauzată de lumina blițului.\nMutați-vă ușor actul de identitate pentru a o evita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте бликов от вспышки.\nМедленно смещайте документ таким образом, чтобы их не было."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "කැමරාවේ ෆ්ලෑෂ් ලයිට් දිලිසුම ගැන විමසිලිමත් වන්න.\nඑය වළක්වා ගැනීමට ඔබේ හැඳුනුම්පත සෙමෙන් එහා මෙහා කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte si pozor na oslnenie baterkou.\nJemne posuňte svoje ID, aby ste sa tomu vyhli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazite na bleščanje bliskavice.\nOsebni dokument rahlo premaknite, da se mu izognete."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazite na odsjaj blica.\nNežno pomerajte lični dokument da biste ga izbegli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Akta dig för reflektioner från kamerablixten.\nFlytta ditt ID försiktigt för att undvika detta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuwa mwangalifu na mwanga wa tochi.\nSogeza taratibu kitambulisho chako ili uuepuke."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระวังแสงจ้าจากไฟฉาย\nค่อย ๆ เลื่อนบัตรประชาชนของคุณไปรอบ ๆ เพื่อหลีกเลี่ยง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaş ışığının parlamasına dikkat et.\nParlamayı önlemek için kimliğini hafifçe hareket ettir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обережно зі спалахом ліхтарика.\nАкуратно перемістіть своє посвідчення особи, щоб уникнути відблиску."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فلیش لائٹ کی چمک سے بچیں۔\nاس سے بچنے کے لیے اپنی شناختی دستاویز کو آہستہ سے حرکت دیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaqnoq akslanishining oldini oling.\nBuning uchun ID hujjatingizni ohista siljiting."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coi chừng lóa sáng do đèn flash.\nNhẹ nhàng di chuyển giấy tờ của bạn qua lại để chống lóa."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ṣóra fun ìtànyòò ìtànsan iná kámẹ́rà.\nRọra máa yí káàdì ìdánimọ̀ rẹ káàkiri láti yẹra fún un."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当心闪光灯眩光。\n请轻轻移动您的身份证件,避免产生眩光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請注意閃光燈眩光。\n慢慢移動您的證件以避免眩光。"
          }
        }
      }
    },
