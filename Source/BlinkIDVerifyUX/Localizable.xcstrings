        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Tẹ̀ ìwé-ẹ̀rí náà sí ẹ̀gbẹ́ díẹ̀ tàbí gbé e láti yọ ìmọ́lẹ̀ tí ó ń tàn kúrò"
