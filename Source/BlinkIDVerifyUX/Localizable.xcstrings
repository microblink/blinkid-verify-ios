        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันยินยอมให้ผู้ให้บริการใช้ข้อมูลส่วนบุคคลของฉันเพื่อพัฒนาเทคโนโลยีของตนให้ดียิ่งขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcının teknolojisini iyileştirmek amacıyla kişisel verilerimi kullanmasına onay veriyorum."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я даю згоду на використання моїх персональних даних постачальником для оптимізації його технології."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
