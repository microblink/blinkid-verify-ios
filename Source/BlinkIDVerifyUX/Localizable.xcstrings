          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Provayder o‘z texnologiyasini optimallashtirish maqsadida mening shaxsiy maʼlumotlarimdan foydalanishiga roziman."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đồng ý cho nhà cung cấp sử dụng dữ liệu cá nhân của mình để tối ưu hóa công nghệ của họ."
          }
        },
        "yo": {
