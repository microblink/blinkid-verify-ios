          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’accepte que le prestataire utilise mes données personnelles afin d’optimiser sa technologie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Je consens à l’utilisation de mes renseignements personnels par le fournisseur afin d’optimiser sa technologie."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
