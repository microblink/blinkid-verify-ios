    "mb_enable_permission_help": {
      "comment": "camera.error.permission.missing_help: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Wɔde wo bɛkɔ pɛmihyen sɛtins baabia ɛsɛ sɛ woma app no kamara pɛmihyen kwa."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "አሁን ለመተግበሪያው የካሜራ ፍቃድ መስጠት ወደሚሰጡበት የፍቃድ ቅንብሮች ይወሰዳሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تحويلك الآن إلى إعدادات الأذونات, حيث تحتاج إلى منح التطبيق إذناً بالوصول إلى الكاميرا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে এখন অনুমতির সেটিংসে নিয়ে যাওয়া হবে, যেখানে আপনাকে অ্যাপটিকে ক্যামেরার অনুমতি দিতে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyní se zobrazí nastavení oprávnění, kde je nutné aplikaci povolit přístup k fotoaparátu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bliver nu ført til tilladelsesindstillingerne, hvor du skal give appen kameratilladelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden jetzt zu den Berechtigungseinstellungen weitergeleitet, wo Sie der App den Zugriff auf die Kamera erlauben müssen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα μεταφερθείτε τώρα στις ρυθμίσεις αδειών όπου θα πρέπει να δώσετε άδεια στην κάμερα στην εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will now be taken to permission settings where you need to give camera permission to the app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You will now be taken to permission settings where you need to give camera permission to the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora se le redirigirá a la configuración de permisos, donde tendrá que otorgar a la aplicación permiso de cámara."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora se te redirigirá a la configuración de los permisos para que autorices el acceso de la aplicación a la cámara."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Hala be tanzimat-e dastresi hedayat mishavid; dar anja bayad ejaze-ye dorbin ra be barname bedahid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinut ohjataan nyt käyttöoikeusasetuksiin. Siellä sinun on annettava sovellukselle kameran käyttöoikeus."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ililipat ka ngayon sa mga setting ng pahintulot kung saan mo bibigyan ng pahintulot ang app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous allez maintenant être redirigé vers les paramètres d'autorisation où vous devez donner à l'application l'autorisation d'accéder à la camera."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez maintenant redirigé vers les paramètres d'autorisation où vous devrez accorder l'autorisation d'utiliser l'appareil photo à l'application."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanzu za a kai ku ɓangaren saitunan izini, wanda a nan ne ake buƙatar ku ba wa manhajar izinin amfani da kamera."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כעת תועבר/י להגדרת הרשאות ושם עליך לתת לאפליקציה הרשאת מצלמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आपको अनुमति सेटिंग पर ले जाया जाएगा जहां आपको ऐप को कैमरे की अनुमति देनी होगी."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bit ćete odvedeni na postavke sustava gdje morate aplikaciji dozvoliti pristup kameri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön most át lesz irányítva az engedélyezési beállításokhoz, ahol engedélyeznie kell az alkalmazás számára a kamera használatát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda kini akan diarahkan ke pengaturan perizinan di mana Anda perlu memberikan izin kamera bagi aplikasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Farið verður í heimildastillingar þar sem gefa þarf appinu leyfi fyrir myndavélinni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora verrai portato alle impostazioni di autorizzazione, dove dovrai fornire l'autorizzazione per l'uso della fotocamera all'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可設定画面に移動し,アプリにカメラへのアクセス許可を与えてください。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "ახლა გადახვალთ ნებართვების პარამეტრებზე, სადაც უნდა დაუშვათ აპლიკაციაში კამერის გამოყენება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енді сізді камераға рұқсат беру үшін рұқсаттар баптауларына бағыттаймыз. Қолданбаға камераны қолдануға рұқсат беруіңіз керек."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "ឥឡូវនេះ អ្នកនឹងត្រូវបាននាំទៅកាន់ការកំណត់ការអនុញ្ញាត ដែលអ្នកត្រូវផ្តល់ការអនុញ្ញាតកាមេរ៉ាដល់កម្មវិធី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 카메라 권한을 허용할 수 있도록 권한 설정으로 이동합니다."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagad jūs novirzīs uz atļauju iestatījumiem, kur lietotnei ir jāpiešķir kameras atļauja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda kini akan dibawa kepada tetapan kebenaran untuk anda memberikan kebenaran kamera kepada aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du blir nå ført til tillatelsesinnstillinger der du må gi kameratillatelse til appen."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंलाई अनुमति सेटिङमा लगिने छ जहाँ तपाईंले एपमा क्यामेरा अनुमति दिन आवश्यक छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U wordt nu omgeleid naar de toegangsinstellingen waar u de app toegangsrechten tot de camera moet geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaniesz teraz przeniesiony do ustawień uprawnień, gdzie należy udzielić aplikacji dostępu do aparatu."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "اوس به تاسو د اجازې ترتیباتو ته وړل کیږئ چیرې چې تاسو اړتیا لرئ اپلیکیشن ته د کیمرې اجازه ورکړئ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai ser redirecionado para as configurações de permissão, onde tem de dar permissão à aplicação para acesso à câmara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você será direcionado para as configurações de permissão, onde precisará conceder permissão para a câmera no aplicativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Veți fi direcționat către setările de permisiuni, unde va trebui să activați accesul la camera foto pentru aplicație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас вы перейдете в раздел разрешений, где нужно будет дать приложению доступ к камере."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "දැන් ඔබව අවසර සැකසුම් වෙත ගෙන යනු ඇති අතර, එහි දී ඔබ යෙදුමට කැමරා අවසරය ලබා දිය යුතු ය."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz budete presmerovaný na nastavenia povolení, kde je nutné udeliť fotoaparátu prístup k aplikácii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdaj boste preusmerjeni v nastavitve dovoljenj, kjer morate aplikaciji dati dovoljenje za kamero."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sada ćete biti preusmereni na podešavanja dozvola, gde treba da dozvolite aplikaciji pristup kameri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tas nu till behörighetsinställningarna där du behöver ge appen kamerabehörighet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasa utaelekezwa kwenye mipangilio ya programu ambapo unahitaji kuiruhusu kamera kwenye programu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
