    "mb_glare_detected": {
      "comment": "scan.error.glare_detected: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyea anaa tu krataa no ma hann a ɛrehyerɛn wɔ so no mfi hɔ"
