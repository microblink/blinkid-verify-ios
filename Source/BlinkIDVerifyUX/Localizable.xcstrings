    "mb_consent_privacy_notice": {
      "comment": "verify.consent.privacy_notice: Complete consent screen body text explaining how the user's choices are used. The verify.privacy.notice.link words appear inside it verbatim and are rendered as a tappable link in a different style.",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Nneɛma a woapaw no boa yɛn ma yɛbɔ wo ankasa ho nsɛm ho ban na yɛma yɛn mfiridwuma tu mpɔn, bere a yɛkɔ so di data kokoamsɛm ho gyinapɛn a ɛkorɔn sen biara so sɛnea wɔaka no {{mb_consent_privacy_link}} no mu."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ምርጫዎችዎ የግል መረጃዎን እንድንጠብቅ እና {{mb_consent_privacy_link}} በሚገልጸው መሠረት ከፍተኛዎቹን የውሂብ ግላዊነት መስፈርቶች እየጠበቅን ቴክኖሎጂያችንን እንድናሻሽል ይረዱናል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعدنا اختياراتك على حماية معلوماتك الشخصية وتحسين تقنيتنا مع الحفاظ على أعلى معايير خصوصية البيانات، كما هو موضح في {{mb_consent_privacy_link}}."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "{{mb_consent_privacy_link}} বর্ণিত তথ্যের গোপনীয়তার সর্বোচ্চ মান বজায় রেখে আপনার পছন্দগুলো আমাদের আপনার ব্যক্তিগত তথ্য সুরক্ষিত রাখতে এবং প্রযুক্তি উন্নত করতে সাহায্য করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše volby nám pomáhají chránit vaše osobní údaje a zlepšovat naši technologii při zachování nejvyšších standardů ochrany osobních údajů, jak je popsáno v {{mb_consent_privacy_link}}."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine valg hjælper os med at beskytte dine personoplysninger og forbedre vores teknologi, samtidig med at vi opretholder de højeste standarder for databeskyttelse som beskrevet i {{mb_consent_privacy_link}}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Auswahl hilft uns, Ihre personenbezogenen Daten zu schützen und unsere Technologie zu verbessern, wobei wir die höchsten Datenschutzstandards einhalten, wie in der {{mb_consent_privacy_link}} beschrieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλογές σας μάς βοηθούν να προστατεύουμε τις προσωπικές σας πληροφορίες και να βελτιώνουμε την τεχνολογία μας, διατηρώντας παράλληλα τα υψηλότερα πρότυπα προστασίας δεδομένων, όπως περιγράφεται στη {{mb_consent_privacy_link}}."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices help us protect your personal information and improve our technology while maintaining the highest standards of data privacy as described in the {{mb_consent_privacy_link}}."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices help us protect your personal information and improve our technology while maintaining the highest standards of data privacy as described in the {{mb_consent_privacy_link}}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus decisiones nos ayudan a proteger su información personal y mejorar nuestra tecnología, manteniendo los más altos estándares de privacidad de datos, como se describe en el {{mb_consent_privacy_link}}."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus decisiones nos ayudan a proteger tu información personal y a mejorar nuestra tecnología, al tiempo que mantenemos los más altos estándares de privacidad de datos, como se describe en el {{mb_consent_privacy_link}}."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Entekhabhaye shoma be ma komak mikonand ta ettela'at-e shakhsi-ye shoma ra hefazat konim va fanavari-ye khod ra behbud dahim, dar hali ke balatarin standardhaye harim-e khosusi-ye dadeha ra, haman-tor ke dar {{mb_consent_privacy_link}} tozih dade shode ast, hefz mikonim."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valintasi auttavat meitä suojaamaan henkilötietojasi ja parantamaan teknologiaamme korkeimpia tietosuojastandardeja noudattaen, kuten {{mb_consent_privacy_link}} kuvataan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makakatulong sa amin ang iyong mga pagpili na protektahan ang iyong personal na impormasyon at pahusayin ang aming teknolohiya, habang pinananatili namin ang pinakamataas na pamantayan sa privacy ng data, gaya ng inilalarawan sa {{mb_consent_privacy_link}}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos choix nous aident à protéger vos informations personnelles et à améliorer notre technologie tout en respectant les normes les plus strictes en matière de confidentialité des données, comme indiqué dans {{mb_consent_privacy_link}}."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos choix nous aident à protéger vos renseignements personnels et à améliorer notre technologie, tout en respectant les normes les plus élevées en matière de protection des données, comme indiqué dans l’{{mb_consent_privacy_link}}."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓukanka suna taimaka mana mu kare bayananka na sirri da inganta fasaharmu, yayin da muke kiyaye mafi girman ƙa'idodin sirrin bayanai kamar yadda aka bayyana a cikin {{mb_consent_privacy_link}}."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבחירות שלך מסייעות לנו להגן על המידע האישי שלך ולשפר את הטכנולוגיה שלנו, תוך עמידה בסטנדרטים הגבוהים ביותר של פרטיות נתונים, כפי שמתואר ב{{mb_consent_privacy_link}}."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके विकल्प, {{mb_consent_privacy_link}} में बताए गए डेटा गोपनीयता के उच्चतम मानकों को बनाए रखते हुए, हमें आपकी व्यक्तिगत जानकारी की सुरक्षा करने और हमारी तकनीक में सुधार करने में मदद करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši odabiri pomažu nam zaštititi vaše osobne podatke i unaprijediti našu tehnologiju uz održavanje najviših standarda privatnosti podataka, kako je opisano u {{mb_consent_privacy_link}}."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Döntései segítenek személyes adatainak védelmében és technológiánk fejlesztésében, miközben az {{mb_consent_privacy_link}} leírtaknak megfelelően fenntartjuk az adatvédelem legmagasabb szintjét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan Anda membantu kami melindungi informasi pribadi Anda dan meningkatkan teknologi kami sambil mempertahankan standar privasi data tertinggi, seperti yang dijelaskan dalam {{mb_consent_privacy_link}}."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Val þitt hjálpar okkur að vernda persónuupplýsingar þínar og bæta tækni okkar um leið og við fylgjum ströngustu kröfum um persónuvernd, eins og lýst er í {{mb_consent_privacy_link}}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scelte ci aiutano a proteggere le tue informazioni personali e a migliorare la nostra tecnologia, mantenendo i più elevati standard di riservatezza dei dati, come descritto nell'{{mb_consent_privacy_link}}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様の選択は、{{mb_consent_privacy_link}}に記載のとおり、最高水準のデータプライバシーを維持しながら、個人情報の保護と当社技術の改善に役立ちます。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი არჩევანი გვეხმარება, დავიცვათ თქვენი პერსონალური ინფორმაცია და გავაუმჯობესოთ ჩვენი ტექნოლოგია მონაცემთა კონფიდენციალურობის უმაღლესი სტანდარტების დაცვით, როგორც ეს აღწერილია {{mb_consent_privacy_link}}."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдауларыңыз {{mb_consent_privacy_link}} сипатталғандай деректер құпиялылығының ең жоғары стандарттарын сақтай отырып, жеке ақпаратыңызды қорғауға және технологиямызды жақсартуға көмектеседі."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "ជម្រើសរបស់អ្នកជួយយើងការពារព័ត៌មានផ្ទាល់ខ្លួនរបស់អ្នក និងកែលម្អបច្ចេកវិទ្យារបស់យើង ខណៈពេលរក្សាបាននូវស្តង់ដារខ្ពស់បំផុតនៃភាពឯកជនទិន្នន័យ ដូចដែលបានពិពណ៌នាក្នុង{{mb_consent_privacy_link}}។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 선택은 {{mb_consent_privacy_link}}에 설명된 대로 최고 수준의 데이터 프라이버시 기준을 유지하면서 개인정보를 보호하고 당사의 기술을 개선하는 데 도움이 됩니다."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu izvēles palīdz mums aizsargāt jūsu personas informāciju un uzlabot mūsu tehnoloģiju, vienlaikus ievērojot augstākos datu privātuma standartus, kā aprakstīts {{mb_consent_privacy_link}}."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan anda membantu kami melindungi maklumat peribadi anda dan menambah baik teknologi kami sambil mengekalkan standard privasi data tertinggi seperti yang diterangkan dalam {{mb_consent_privacy_link}}."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgene dine hjelper oss med å beskytte personopplysningene dine og forbedre teknologien vår, samtidig som vi opprettholder de høyeste standardene for personvern, slik det er beskrevet i {{mb_consent_privacy_link}}."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंका छनोटहरूले {{mb_consent_privacy_link}} वर्णन गरिएअनुसार डेटा गोपनीयताका उच्चतम मापदण्डहरू कायम राख्दै तपाईंको व्यक्तिगत जानकारी सुरक्षित गर्न र हाम्रो प्रविधि सुधार गर्न मद्दत गर्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw keuzes helpen ons uw persoonsgegevens te beschermen en onze technologie te verbeteren, terwijl we de hoogste normen voor gegevensbescherming naleven, zoals beschreven in de {{mb_consent_privacy_link}}."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wybory pomagają nam chronić Twoje dane osobowe i ulepszać naszą technologię przy zachowaniu najwyższych standardów prywatności danych, opisanych w {{mb_consent_privacy_link}}."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "ستاسو انتخابونه له موږ سره مرسته کوي چې ستاسو شخصي معلومات خوندي کړو او خپله ټکنالوژي ښه کړو، په داسې حال کې چې د معلوماتو د محرمیت تر ټولو لوړ معیارونه ساتو، لکه څنګه چې {{mb_consent_privacy_link}} کې بیان شوي دي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas escolhas ajudam-nos a proteger as suas informações pessoais e a melhorar a nossa tecnologia, mantendo os mais elevados padrões de privacidade de dados, conforme descrito no {{mb_consent_privacy_link}}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas escolhas nos ajudam a proteger suas informações pessoais e a melhorar nossa tecnologia, mantendo os mais altos padrões de privacidade de dados, conforme descrito no {{mb_consent_privacy_link}}."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțiunile dumneavoastră ne ajută să vă protejăm informațiile cu caracter personal și să ne îmbunătățim tehnologia, menținând totodată cele mai înalte standarde de confidențialitate a datelor, astfel cum sunt descrise în {{mb_consent_privacy_link}}."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш выбор помогает нам защищать вашу личную информацию и совершенствовать наши технологии, соблюдая высочайшие стандарты конфиденциальности данных, описанные в {{mb_consent_privacy_link}}."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "{{mb_consent_privacy_link}} විස්තර කර ඇති පරිදි, ඔබගේ තේරීම් ඔබගේ පුද්ගලික තොරතුරු ආරක්ෂා කිරීමට සහ දත්ත රහස්‍යතාවේ ඉහළම ප්‍රමිතීන් පවත්වාගෙන යමින් අපගේ තාක්ෂණය වැඩිදියුණු කිරීමට අපට උපකාරී වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše voľby nám pomáhajú chrániť vaše osobné údaje a zlepšovať našu technológiu pri zachovaní najvyšších štandardov ochrany súkromia, ako je uvedené v {{mb_consent_privacy_link}}."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše izbire nam pomagajo varovati vaše osebne podatke in izboljševati našo tehnologijo ob ohranjanju najvišjih standardov zasebnosti podatkov, kot je opisano v {{mb_consent_privacy_link}}."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši izbori nam pomažu da zaštitimo vaše lične podatke i unapredimo našu tehnologiju uz poštovanje najviših standarda privatnosti podataka, kako je opisano u {{mb_consent_privacy_link}}."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina val hjälper oss att skydda dina personuppgifter och förbättra vår teknik, samtidigt som vi upprätthåller de högsta standarderna för dataskydd enligt beskrivningen i {{mb_consent_privacy_link}}."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaguo zako hutusaidia kulinda taarifa zako za kibinafsi na kuboresha teknolojia yetu huku tukidumisha viwango vya juu zaidi vya faragha ya data, kama ilivyoelezwa katika {{mb_consent_privacy_link}}."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลือกของคุณช่วยให้เราปกป้องข้อมูลส่วนบุคคลของคุณและพัฒนาเทคโนโลยีของเรา พร้อมทั้งรักษามาตรฐานสูงสุดด้านความเป็นส่วนตัวของข้อมูลตามที่อธิบายไว้ใน{{mb_consent_privacy_link}}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçimleriniz, {{mb_consent_privacy_link}} açıklandığı üzere, en yüksek veri gizliliği standartlarını korurken kişisel bilgilerinizi korumamıza ve teknolojimizi geliştirmemize yardımcı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш вибір допомагає нам захищати вашу персональну інформацію та вдосконалювати нашу технологію, дотримуючись найвищих стандартів конфіденційності даних, як описано в {{mb_consent_privacy_link}}."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے انتخاب ہماری مدد کرتے ہیں کہ ہم آپ کی ذاتی معلومات کا تحفظ کریں اور ڈیٹا کی رازداری کے اعلیٰ ترین معیارات برقرار رکھتے ہوئے اپنی ٹیکنالوجی بہتر بنائیں، جیسا کہ {{mb_consent_privacy_link}} میں بیان کیا گیا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlovlaringiz shaxsiy maʼlumotlaringizni himoya qilishga va {{mb_consent_privacy_link}} bayon etilganidek, maʼlumotlar maxfiyligining eng yuqori standartlariga rioya qilgan holda texnologiyamizni yaxshilashga yordam beradi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lựa chọn của bạn giúp chúng tôi bảo vệ thông tin cá nhân của bạn và cải thiện công nghệ, đồng thời duy trì các tiêu chuẩn cao nhất về quyền riêng tư dữ liệu như được mô tả trong {{mb_consent_privacy_link}}."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Àwọn yíyàn rẹ ń ràn wá lọ́wọ́ láti dáàbò bo ìwífún ti ara rẹ àti láti mú ìmọ̀ ẹ̀rọ wa sunwọ̀n sí i, nígbà tí a ń tẹ̀lé àwọn ìlànà gíga jù lọ fún ìpamọ́ àṣírí dátà, gẹ́gẹ́ bí a ṣe ṣàlàyé nínú {{mb_consent_privacy_link}}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的选择有助于我们保护您的个人信息、改进我们的技术，并遵循《{{mb_consent_privacy_link}}》中所述的最高数据隐私标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的選擇有助於我們保護您的個人資訊，並在維持最高資料隱私標準的同時改善我們的技術，如{{mb_consent_privacy_link}}所述。"
          }
        }
      }
    },
    "mb_consent_privacy_switch": {
      "comment": "verify.consent.consent_switch: Label of the optional consent toggle on the consent screen. It is written in the user's own voice as a first-person statement.",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Mepene so sɛ ɔdemafo no de me ankasa ho nsɛm bedi dwuma de ama ne mfiridwuma atu mpɔn."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቴክኖሎጂውን ለማሻሻል አቅራቢው የግል ውሂቤን እንዲጠቀም እስማማለሁ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق على استخدام مقدّم الخدمة لبياناتي الشخصية بغرض تحسين تقنياته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রদানকারীর প্রযুক্তি উন্নত করার উদ্দেশ্যে আমার ব্যক্তিগত তথ্য ব্যবহারে আমি সম্মতি দিচ্ছি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhlasím s použitím svých osobních údajů poskytovatelem za účelem optimalizace jeho technologie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg giver samtykke til, at udbyderen bruger mine personoplysninger til at optimere sin teknologi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich willige ein, dass der Anbieter meine personenbezogenen Daten zur Optimierung seiner Technologie verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συναινώ στη χρήση των προσωπικών μου δεδομένων από τον πάροχο για τη βελτιστοποίηση της τεχνολογίας του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I consent to the use of my personal data by the provider for the purpose of optimizing its technology."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I consent to the use of my personal data by the provider for the purpose of optimising its technology."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doy mi consentimiento para que el proveedor use mis datos personales con el fin de optimizar su tecnología."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Doy mi consentimiento para que el proveedor use mis datos personales con el fin de optimizar su tecnología."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Man rezayat midaham ke era'e-konande az dadehaye shakhsi-ye man baraye behine-sazi-ye fanavari-ye khod estefade konad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Annan suostumukseni siihen, että palveluntarjoaja käyttää henkilötietojani teknologiansa optimointiin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
