        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajem privolu pružatelju usluge za upotrebu mojih osobnih podataka u svrhu optimizacije njegove tehnologije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzájárulok ahhoz, hogy a szolgáltató technológiájának optimalizálása céljából felhasználja személyes adataimat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya menyetujui penggunaan data pribadi saya oleh penyedia untuk mengoptimalkan teknologinya."
