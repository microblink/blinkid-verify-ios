        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ነጸብራቁን ለማስወገድ ሰነዱን ያዘንብሉ ወይም ያንቀሳቅሱ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
