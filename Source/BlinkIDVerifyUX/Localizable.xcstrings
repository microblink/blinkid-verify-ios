        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं प्रदाता को उसकी तकनीक के अनुकूलन के उद्देश्य से अपने व्यक्तिगत डेटा का उपयोग करने की सहमति देता/देती हूँ।"
          }
