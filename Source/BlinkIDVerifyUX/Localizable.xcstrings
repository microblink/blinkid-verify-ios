          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt de acord ca furnizorul să utilizeze datele mele cu caracter personal pentru optimizarea tehnologiei sale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
