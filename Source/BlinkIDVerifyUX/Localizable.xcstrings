        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke læse dokumentet. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument kann nicht gelesen werden. Bitte versuchen Sie es erneut."
