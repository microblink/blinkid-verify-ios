        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "زه رضایت ورکوم چې وړاندې کوونکی زما شخصي معلومات د خپلې ټکنالوژۍ د ښه کولو لپاره وکاروي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dou o meu consentimento para que o fornecedor utilize os meus dados pessoais com o objetivo de otimizar a sua tecnologia."
