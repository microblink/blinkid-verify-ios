    "mb_onboarding_dialog_message": {
      "comment": "scan.onboarding.document.message: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Hwɛ hu sɛ wobɛma han atɔ krataa no so yiye. Ɛsɛ sɛ wohu krataa a no afa nyinaa wɔ kamara no skreen so."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰነዱ በቂ ብርሃን ማግኘቱን ያረጋግጡ። ሁሉም የሰነድ መስኮች በካሜራ ማያ ገጽ ላይ መታየት አለባቸው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من إبقاء المستند مضاءً بشكل جيد. كما يجب أن تكون جميع خانات المستندات واضحة على شاشة الكاميرا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত করুন যে আপনার ডকুমেন্টটি ভালোভাবে আলোকিত আছে। ক্যামেরার স্ক্রিনে ডকুমেন্টের সমস্ত তথ্য স্পষ্টভাবে দৃশ্যমান হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že je dokument dobře osvětlen. Na obrazovce fotoaparátu by měla být vidět všechna pole dokumentu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at dokumentet er godt oplyst. Alle dokumentets felter skal være synlige på kameraskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgen Sie dafür, dass das Dokument gut belichtet ist. Alle Bereiche des Dokuments sollten auf dem Kamerabildschirm sichtbar sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φροντίστε το έγγραφο να είναι καλά φωτισμένο. Όλα τα πεδία του εγγράφου θα πρέπει να είναι ορατά στην οθόνη της κάμερας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you keep the document well lit. All document fields should be visible on the camera screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you keep the document well lit. All document fields should be visible on the camera screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrese de mantener el documento bien iluminado. Todos los campos del documento deben ser visibles en la pantalla de la cámara."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que el documento esté bien iluminado. Deberán verse todos los campos del documento en la pantalla de la cámara."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Motma'en shavid ke mostanad khub roshan ast. Hame-ye fild-haye mostanad bayad dar namayeshgar-e dowbin dida shavand."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että asiakirja on hyvin valaistu. Kaikkien asiakirjan kenttien tulee näkyä kameran näytöllä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiyaki na lubos na naiilawan ang dokumento. Dapat nakikita sa screen ng camera ang lahat ng field ng dokumento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez soin de garder le document bien éclairé. Tous les champs du document doivent être visibles sur l'écran de la caméra."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que le document est bien éclairé. Tous les champs du document doivent être visibles sur l'écran de l'appareil photo."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabbatar da an haska ɗaukacin takardar. Ya kasance ana ganin dukkannin ɓangarorin takardar a cikin sikirin ɗin kamera."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסמך חייב להיות מואר היטב. כל שדות המסמכים צריכים להיות גלויים על מסך המצלמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनिश्चित करें कि दस्तावेज़ पर अच्छी रोशनी हो. सभी दस्तावेज़ फ़ील्ड कैमरा स्क्रीन पर दिखाई देने चाहिए."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripazite da dokument bude dovoljno osvijetljen. Svi podaci s dokumenta trebaju biti vidljivi na ekranu vašeg uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ügyeljen a dokumentum megfelelő megvilágítására. Minden dokumentummezőnek láthatónak kell lennie a kameraképernyőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan dokumen cukup diterangi cahaya. Semua bagian dokumen harus terlihat di layar kamera."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gangið úr skugga um að skjalið sé vel lýst. Allir reitir skjals ættu að vera sýnilegir á skjá myndavélarinnar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla che il documento sia ben illuminato. Tutti i campi del documento devono essere visibili sullo schermo della fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類を十分に明るく保ち,カメラの画面に書類のすべての項目が映っていることを確認してください。"
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "დარწმუნდით, რომ დოკუმენტი კარგად არის განათებული. კამერის ეკრანზე დოკუმენტის ყველა ველი უნდა ჩანდეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құжат жақсы жарықта екеніне көз жеткізіңіз. Құжаттағы барлық өрістер камера экранында көрініп тұруы керек."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "ត្រូវប្រាកដថាអ្នករក្សាឯកសារឱ្យបានល្អ វាលឯកសារទាំងអស់គួរតែអាចមើលឃើញនៅលើអេក្រង់កាមេរ៉ា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서가 조명을 충분히 받을 수 있게 유지하세요. 모든 문서 내용들이 카메라 화면에 보여야 합니다."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārliecinieties, vai dokuments ir labi apgaismots. Kameras ekrānā jābūt redzamiem visiem dokumenta laukiem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan dokumen anda menerima pencahayaan yang cukup. Semua medan dokumen hendaklah kelihatan pada skrin kamera."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at dokumentet er godt opplyst. Alle feltene i dokumentet skal være synlige på kameraskjermen."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कागजात उज्यालो राख्नुहोस्। सबै कागजात फिल्ड क्यामेरा स्क्रिनमा देखिने हुनुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat het document goed verlicht is. Alle velden op het document moeten onder het camerascherm zichtbaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że dokument jest dobrze oświetlony. Wszystkie pola dokumentu powinny być widoczne na ekranie aparatu."
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "ډاډ ترلاسه کړئ چې تاسو سند ښه روښانه ساتئ. د اسنادو ټولې ساحې باید د کیمرې په سکرین کې ښکاره شي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegure-se de que mantém o documento bem iluminado. Todos os campos do documento devem estar visíveis no ecrã da câmara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de manter o documento bem iluminado. Todos os campos do documento devem estar visíveis na tela da câmera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigurați-vă că documentul este bine iluminat. Toate secțiunile din document trebuie să fie vizibile pe ecranul camerei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте так, чтобы документ был хорошо освещен. Все его поля должны быть видны на экране камеры."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ලේඛනයට හොඳින් ආලෝකය වැටෙන පරිදි තබා ගැනීමට වග බලා ගන්න. ලේඛනයේ සියලුම කොටස් කැමරා තිරය මත දෘශ්‍යමාන විය යුතු ය."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uistite sa, že máte dokument dobre osvetlený. Všetky polia dokumentu by mali byť viditeľné na obrazovke fotoaparátu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskrbite, da bo dokument dobro osvetljen. Na zaslonu kamere morajo biti vidna vsa polja dokumenta."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uverite se da je dokument dobro osvetljen. Sva polja dokumenta treba da budu vidljiva na ekranu kamere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att dokumentet är väl belyst. Alla fält i dokumentet ska synas på kameraskärmen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakikisha hati iko kwenye mwanga wa kutosha. Sehemu zote za hati zinapaswa kuonekana kwenye skrini ya kamera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบว่าเอกสารของคุณมีแสงสว่างเพียงพอ คุณควรมองเห็นทุกส่วนของเอกสารบนหน้าจอกล้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgenin iyi aydınlatıldığından emin ol. Tüm belge alanları kamera ekranında görünür olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що документ добре освітлений. Усі поля документа мають бути видимими на екрані камери."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یقینی بنائیں کہ دستاویز اچھی طرح روشن ہو۔ دستاویز کے تمام خانے کیمرہ اسکرین پر واضح نظر آنے چاہئیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hujjat yetarlicha yoritilganiga ishonch hosil qiling. Hujjatning barcha maydonlari kamera ekranida koʻrinishi kerak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo rằng bạn giữ cho tài liệu được chiếu sáng tốt. Tất cả các trường tài liệu sẽ hiển thị trên màn hình camera."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ríi dájú pé ìmọ́lẹ̀ tàn sórí ìwé àkọsílẹ̀ náà dáadáa. Gbogbo ààyè orí ìwé àkọsílẹ̀ náà ni kó sí hàn kedere lórí àwo kámẹ́rà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保文件处于光线充足的地方。所有文件字段应在相机屏幕上可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確保文件光線充足。所有文件欄位在相機螢幕都應清楚可見。"
          }
        }
      }
    },
    "mb_onboarding_dialog_title": {
      "comment": "scan.onboarding.document.title: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Hwɛ sɛ wobehu afa nyinaa"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሁሉንም ዝርዝሮች እንዲታዩ ያድርጉ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من وضوح جميع البيانات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্ত বিবরণ দৃশ্যমান রাখুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny detaily musejí být ve viditelném stavu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold alle oplysningerne synlige"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie alle Informationen sichtbar"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φροντίστε όλες οι λεπτομέρειες να είναι ορατές"
          }
        },
        "en": {
