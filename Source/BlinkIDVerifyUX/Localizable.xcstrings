    "mb_consent_description": {
      "comment": "verify.consent.description: Body text of the consent screen, shown as its own element directly under verify.consent.title and continuing that heading's sentence. It must read as the completion of that sentence and also open like a normal block of text, not mid-clause.",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Kora wo ankasa ho nsɛm so na/anaa nya ho kwan de gye wo nipasu tom."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማንነትዎን ለማረጋገጥ የግል መረጃን ማከማቸት እና/ወይም ማግኘት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخزين المعلومات الشخصية و/أو الوصول إليها لغرض التحقق من هويتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচয় যাচাইয়ের উদ্দেশ্যে ব্যক্তিগত তথ্য সংরক্ষণ এবং/অথবা অ্যাক্সেস করার জন্য।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládáním a/nebo přístupem k osobním údajům za účelem ověření vaší identity."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lagre og/eller få adgang til personoplysninger med henblik på at bekræfte din identitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
