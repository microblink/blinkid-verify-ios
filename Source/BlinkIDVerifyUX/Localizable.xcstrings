    "mb_consent_title": {
      "comment": "verify.consent.title: Heading of the consent screen and the opening of a sentence that the verify.consent.description body text completes. The two are rendered as separate elements, so it ends with the colon that introduces the list beneath it.",
      "extractionState": "manual",
      "localizations": {
        "ak": {
