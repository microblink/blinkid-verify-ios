    "mb_recognition_timeout_dialog_message": {
      "comment": "scan.error.unsuccessful.message.document_old: ",
      "extractionState": "manual",
      "localizations": {
        "ak": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontumi nkan krataa no. Yɛsrɛw san yɛ bio."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሰነዱን ማንበብ አልተቻለም እባክዎ እንደገና ይሞክሩ።"
