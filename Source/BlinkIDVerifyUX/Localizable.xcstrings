        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қызмет көрсетушінің өз технологиясын оңтайландыру мақсатында менің жеке деректерімді пайдалануына келісім беремін."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "ខ្ញុំយល់ព្រមឱ្យអ្នកផ្តល់សេវាប្រើប្រាស់ទិន្នន័យផ្ទាល់ខ្លួនរបស់ខ្ញុំ ដើម្បីបង្កើនប្រសិទ្ធភាពបច្ចេកវិទ្យារបស់ខ្លួន។"
