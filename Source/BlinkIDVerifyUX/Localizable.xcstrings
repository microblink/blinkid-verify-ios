        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik stem ermee in dat de aanbieder mijn persoonsgegevens gebruikt om zijn technologie te optimaliseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrażam zgodę na wykorzystanie moich danych osobowych przez usługodawcę w celu optymalizacji jego technologii."
