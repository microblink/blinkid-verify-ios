{"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.microblink.BlinkIDVerify\/documentation\/BlinkIDVerify\/BarcodeElementKey\/standardVersionNumber"},"hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkIDVerify\/documentation\/BlinkIDVerify","doc:\/\/com.microblink.BlinkIDVerify\/documentation\/BlinkIDVerify\/BarcodeElementKey"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standardVersionNumber","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"AAMVA Version Number: This is a decimal value between 0 and 99 that"},{"type":"text","text":" "},{"type":"text","text":"specifies the version level of the PDF417 bar code format. Version “0” and “00”"},{"type":"text","text":" "},{"type":"text","text":"is reserved for bar codes printed to the specification of the American Association"},{"type":"text","text":" "},{"type":"text","text":"of Motor Vehicle Administrators (AAMVA) prior to the adoption of the AAMVA DL\/ID-2000"},{"type":"text","text":" "},{"type":"text","text":"standard."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All barcodes compliant with AAMVA DL\/ID-2000 standard shall be designated Version “01.”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Specification version 1.0, dated 09-2003","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “02.”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Specification version 2.0, dated 03-2005","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “03.”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Standard version 1.0, dated 07-2009","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “04.”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Standard version 1.0, dated 07-2010","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “05.”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Standard version 1.0, dated 07-2011","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “06”.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All barcodes compliant with AAMVA Card Design Standard version 1.0, dated 06-2012","type":"text"},{"text":" ","type":"text"},{"text":"shall be designated Version “07”.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All barcodes compliant with this current AAMVA standard shall be designated “08”.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"If the document type is not “AAMVA”, this field defines the version number of the"},{"type":"text","text":" "},{"type":"text","text":"given document type’s standard."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"BlinkIDVerify"}],"title":"BarcodeElementKey.standardVersionNumber","externalID":"s:13BlinkIDVerify17BarcodeElementKeyO21standardVersionNumberyA2CmF","roleHeading":"Case","symbolKind":"case","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standardVersionNumber","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/blinkidverify\/barcodeelementkey\/standardversionnumber"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","tex