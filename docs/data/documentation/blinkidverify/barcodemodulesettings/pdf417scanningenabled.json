{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.microblink.BlinkIDVerify\/documentation\/BlinkIDVerify\/BarcodeModuleSettings\/pdf417ScanningEnabled"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkIDVerify\/documentation\/BlinkIDVerify","doc:\/\/com.microblink.BlinkIDVerify\/documentation\/BlinkIDVerify\/BarcodeModuleSettings"]]},"metadata":{"modules":[{"name":"BlinkIDVerify"}],"externalID":"s:13BlinkIDVerify21BarcodeModuleSettingsV21pdf417ScanningEnabledSbvp","symbolKind":"property","roleHeading":"Instance Property","title":"pdf417ScanningEnabled","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdf417ScanningEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol"},"sections":[],"abstract":[{"type":"text","text":"Enables the scanning and processing of Pdf417 barcodes."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/blinkidverify\/barcodemodulesettings\/pdf417scanningenabled"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdf417ScanningEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The current analyzer model flags a barcode as “present” if either a ","type":"text"},{"code":"PDF417","type":"codeVoice"},{"text":" or a ","type":"text"},{"code":"QR","type":"codeVoice"},{"text":" code is detected.","type":"text"},{"text":" ","type":"text"},{"text":"Because the model does not distinguish between the two types at this stage, a conflict can occur:","type":"text"},{"text":" ","type":"text"},{"text":"if ","type":"text"},{"code":"PDF417","type":"codeVoice"},{"text":" is enabled but ","type":"text"},{"code":"QR","type":"codeVoice"},{"text":" is disabled, the analyzer may trigger for a ","type":"text"},{"code":"QR","type":"codeVoice"},{"text":" code, causing the process to hang.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To prevent this, ","type":"text"},{"code":"pdf417ScanningEnabled","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"qrScanningEnabled","type":"codeVoice"},{"text":" must be enabled together.","type":"text"}]}]}],"references":{"doc://com.microblink.BlinkIDVerify/documentation/BlinkIDVerify/BarcodeModuleSettings/pdf417ScanningEnabled":{"abstract":[{"text":"Enables the scanning and processing of Pdf417 barcodes.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/com.microblink.BlinkIDVerify\/documentation\/BlinkIDVerify\/BarcodeModuleSettings\/pdf417ScanningEnabled","title":"pdf417ScanningEnabled","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdf417ScanningEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/blinkidverify\/barcodemodulesettings\/pdf417scanningenabled"},"doc://com.microblink.BlinkIDVerify/documentation/BlinkIDVerify":{"kind":"symbol","type":"topic","url":"\/documentation\/blinkidverify","title":"BlinkIDVerify","identifier":"doc:\/\/com.microblink.BlinkIDVerify\/documentation\/BlinkIDVerify","role":"collection","abstract":[]},"doc://com.microblink.BlinkIDVerify/documentation/BlinkIDVerify/BarcodeModuleSettings":{"identifier":"doc:\/\/com.microblink.BlinkIDVerify\/documentation\/BlinkIDVerify\/BarcodeModuleSettings","title":"BarcodeModuleSettings","type":"topic","navigatorTitle":[{"kind":"identifier","text":"BarcodeModuleSettings"}],"kind":"symbol","abstract":[{"type":"text","text":"Settings for th